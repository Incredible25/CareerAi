# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/3doors
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3doors"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI career assistant (optional). Without this set, the assistant chat
# still works but replies with a "not configured" notice instead of a
# real answer — the rest of the app (matches, skill gaps, roadmap,
# side-income) does not depend on this key at all.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Phase 7 beta configuration (docs/PHASE_7_BETA_CONFIGURATION.md). One of:
# development | staging | beta | production. Unset, this is inferred
# from NODE_ENV (production -> "production", else "development") — only
# set this explicitly to reach "staging" or "beta", which nothing infers.
# DEPLOYMENT_STAGE="beta"

# Beta kill switch — only meaningful when DEPLOYMENT_STAGE=beta. Set to
# the literal string "false" to lock out beta-cohort accounts (isBetaUser
# = true) without a deploy; anything else (including unset) means beta
# access stays enabled. Never affects non-beta accounts.
# BETA_ACCESS_ENABLED="true"

# Set to "true" ONLY once the production reverse proxy is confirmed to
# overwrite (not append to) any client-supplied X-Forwarded-For header
# with the real connecting IP. Until then, pre-auth rate limiting
# (register/login) ignores the header entirely — a client can otherwise
# spoof it to get a fresh rate-limit bucket on every request. See
# src/lib/rate-limit.ts and docs/PHASE_6_DECISIONS.md. Leave unset in
# local dev and CI.
# TRUST_PROXY_HEADERS="true"
