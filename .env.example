# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/3doors
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3doors"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI career assistant (optional). Without this set, the assistant chat
# still works but replies with a "not configured" notice instead of a
# real answer — the rest of the app (matches, skill gaps, roadmap,
# side-income) does not depend on this key at all.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
