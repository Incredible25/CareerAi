// 3Doors — schema.
//
// Phase 1 (identity, profile, education, the shared skills/interests
// catalogs, the self-discovery assessment), Phase 2/3 (the Career Guidance
// Engine: career and side-income knowledge bases, generated matches,
// skill gaps, roadmaps, the AI assistant, the portfolio tracker), and now
// Phase 4, the Verified Opportunity Engine: a controlled, admin-curated
// opportunity catalog with a verification workflow, deterministic
// matching, saving, application tracking, and reporting.
//
// The opportunity catalog is never populated by scraping or AI generation
// — every Opportunity traces to a Source a human admin created, and the
// public-facing queries (feed, matching, dashboard) only ever read rows
// where verificationStatus = VERIFIED and opportunityStatus = ACTIVE.
// See docs/PRODUCT_STRATEGY.md for the full verification architecture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

enum AgeRange {
  UNDER_16
  AGE_16_18
  AGE_19_24
  AGE_25_30
  OVER_30
}

// Phase 4: the first admin concept in the codebase. There is no self-serve
// path to ADMIN — it's granted via prisma/promote-admin.ts, run directly
// against the database by someone with deploy access, never through a UI.
enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  ageRange     AgeRange
  country      String
  city         String?
  // Derived at registration from ageRange (docs/PRODUCT_STRATEGY.md §13
  // names this as the intended minor-safeguarding gate). Phase 5 Module 6
  // audit: as of this comment, nothing in the app actually reads this
  // field — it does not currently gate any behavior. Flagged for the
  // beta-readiness review rather than silently left implying a live
  // safeguard; do not remove without deciding what should read it.
  isMinor      Boolean  @default(false)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       Profile?
  education     Education[]
  userSkills    UserSkill[]
  userInterests UserInterest[]
  assessments   Assessment[]

  careerMatches     CareerMatch[]
  skillGaps         SkillGap[]
  roadmaps          Roadmap[]
  sideIncomeMatches SideIncomeMatch[]
  portfolioProjects PortfolioProject[]
  aiConversations   AiConversation[]

  opportunityMatches      OpportunityMatch[]
  opportunityApplications OpportunityApplication[]
  opportunityReports      OpportunityReport[]
  createdOpportunities    Opportunity[]            @relation("OpportunityCreatedBy")
  updatedOpportunities    Opportunity[]            @relation("OpportunityUpdatedBy")

  feedback Feedback[]

  @@map("users")
}

enum EducationLevel {
  SECONDARY
  UNIVERSITY
  GRADUATE
  OTHER
}

enum WorkEnvironment {
  REMOTE
  IN_PERSON
  HYBRID
  NO_PREFERENCE
}

enum InternetAccess {
  RELIABLE_DAILY
  INTERMITTENT
  LIMITED
}

// The "soft" data the recommendation engine (Phase 2) will read: goals,
// preferences, and the access/resource constraints that make a roadmap
// realistic rather than generic.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  careerGoals           String?
  incomeGoal            String?
  preferredEnvironment  WorkEnvironment?
  availableHoursPerWeek Int?
  hasLaptop             Boolean?
  hasSmartphone         Boolean?
  internetAccess        InternetAccess?
  languages             String[]         @default([])
  linkedinUrl           String?
  portfolioUrl          String?

  // Progressive onboarding position — which step the user last completed,
  // so a return visit resumes rather than restarts
  // (docs/PRODUCT_STRATEGY.md §4).
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Education {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       EducationLevel
  institution String?
  program     String?
  subjects    String[]       @default([])
  strengths   String[]       @default([])
  isCurrent   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@map("education")
}

// ---------------------------------------------------------------------------
// Shared skills & interests catalogs (admin-curated, seeded — see prisma/seed.ts)
// ---------------------------------------------------------------------------

model Skill {
  id         String      @id @default(cuid())
  name       String      @unique
  category   String?
  userSkills UserSkill[]

  careerSkills          CareerSkill[]
  sideOpportunitySkills SideOpportunitySkill[]
  skillGaps             SkillGap[]
  opportunitySkills     OpportunitySkill[]

  @@map("skills")
}

model Interest {
  id            String         @id @default(cuid())
  name          String         @unique
  category      String?
  userInterests UserInterest[]

  @@map("interests")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model UserSkill {
  id      String     @id @default(cuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill      @relation(fields: [skillId], references: [id])
  level   SkillLevel

  @@unique([userId, skillId])
  @@map("user_skills")
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id])

  @@unique([userId, interestId])
  @@map("user_interests")
}

// ---------------------------------------------------------------------------
// Self-discovery assessment
// ---------------------------------------------------------------------------

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

model Assessment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AssessmentStatus @default(IN_PROGRESS)
  // Structured per-trait scores computed on submit (see
  // src/lib/assessment/scoring.ts). Consumed by the Phase 2 recommendation
  // engine — this is the "structured user profile" the assessment
  // (docs/PRODUCT_STRATEGY.md §5) is required to produce.
  traitScores Json?
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  answers       AssessmentAnswer[]
  careerMatches CareerMatch[]

  @@index([userId])
  @@map("assessments")
}

model AssessmentAnswer {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  trait        String
  // 1-5 Likert value
  value        Int
  answeredAt   DateTime   @default(now())

  @@unique([assessmentId, questionId])
  @@map("assessment_answers")
}

// ---------------------------------------------------------------------------
// Career knowledge base (admin-curated — see prisma/seed-careers.ts)
//
// The recommendation engine reasons over these rows; it never invents a
// career, skill requirement, or pathway that isn't stored here
// (docs/PRODUCT_STRATEGY.md §7, §31).
// ---------------------------------------------------------------------------

model CareerProfile {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  industry    String

  responsibilities String[] @default([])

  // Matched against Education.subjects (case-insensitive) for the
  // Subject Match factor.
  relevantSubjects String[] @default([])

  // Matched against UserInterest for the Interest Match factor. Plain
  // strings rather than a join table to the Interest catalog — interest
  // relevance is a coarse, admin-authored signal, not something that
  // needs relational integrity the way skill levels do.
  relevantInterests String[] @default([])

  // Record<TraitKey, number 0..1> — weights used for the Strength Match
  // factor against Assessment.traitScores. Kept as JSON rather than a
  // table since TraitKey is a small, fixed, code-defined enum
  // (src/lib/assessment/questions.ts), not admin-editable data.
  traitWeights Json

  educationPathways     String[] @default([])
  alternativePathways   String[] @default([])
  certifications        String[] @default([])
  beginnerProjects      String[] @default([])
  portfolioRequirements String[] @default([])

  remoteSuitable    Boolean           @default(false)
  freelanceSuitable Boolean           @default(false)
  environments      WorkEnvironment[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careerSkills      CareerSkill[]
  matches           CareerMatch[]
  skillGaps         SkillGap[]
  roadmaps          Roadmap[]
  portfolioProjects PortfolioProject[]
  sideOpportunities CareerSideOpportunity[]
  opportunities     OpportunityCareer[]

  relatedCareers CareerProfile[] @relation("RelatedCareers")
  relatedTo      CareerProfile[] @relation("RelatedCareers")

  @@map("career_profiles")
}

// Curated cross-link between a career and side-income paths worth
// exploring while building toward it (Phase 2, Module 1/6) — distinct
// from SideIncomeMatch, which is a generated, skill-only score decoupled
// from any specific career. This is admin-curated editorial judgment
// ("these two are related"), not a computed result.
model CareerSideOpportunity {
  id                String          @id @default(cuid())
  careerId          String
  career            CareerProfile   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  sideOpportunityId String
  sideOpportunity   SideOpportunity @relation(fields: [sideOpportunityId], references: [id], onDelete: Cascade)

  @@unique([careerId, sideOpportunityId])
  @@map("career_side_opportunities")
}

model CareerSkill {
  id       String        @id @default(cuid())
  careerId String
  career   CareerProfile @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill         @relation(fields: [skillId], references: [id])
  // Level a candidate is expected to reach for this skill.
  level    SkillLevel

  @@unique([careerId, skillId])
  @@map("career_skills")
}

// ---------------------------------------------------------------------------
// Generated career recommendations
// ---------------------------------------------------------------------------

model CareerMatch {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId     String
  career       CareerProfile @relation(fields: [careerId], references: [id])
  assessmentId String?
  assessment   Assessment?   @relation(fields: [assessmentId], references: [id])

  fitScore  Int // 0-100
  // Decomposed sub-scores, one key per factor in the fit-score formula
  // (docs/PRODUCT_STRATEGY.md §8) — powers the transparent "why" UI.
  breakdown Json
  reasons   String[]
  rank      Int

  // Which version of the scoring formula produced this row (Phase 2,
  // Module 2 — src/lib/career-engine/scoring.ts CAREER_ENGINE_VERSION).
  // Lets a future formula change be audited: which matches were computed
  // under which rules, without guessing from generatedAt alone.
  engineVersion String @default("1.0.0")

  generatedAt DateTime @default(now())

  @@unique([userId, careerId, assessmentId])
  @@index([userId])
  @@map("career_matches")
}

// ---------------------------------------------------------------------------
// Skill gaps & roadmap (generated per user + chosen career)
// ---------------------------------------------------------------------------

model SkillGap {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId String
  career   CareerProfile @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill         @relation(fields: [skillId], references: [id])

  currentLevel  SkillLevel?
  requiredLevel SkillLevel
  // Bigger gap = lower priority number = tackle first.
  priority      Int

  generatedAt DateTime @default(now())

  @@unique([userId, careerId, skillId])
  @@map("skill_gaps")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Roadmap {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId    String
  career      CareerProfile @relation(fields: [careerId], references: [id], onDelete: Cascade)
  totalWeeks  Int
  generatedAt DateTime      @default(now())

  tasks RoadmapTask[]

  @@unique([userId, careerId])
  @@map("roadmaps")
}

model RoadmapTask {
  id          String     @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  phase       String
  weekStart   Int
  weekEnd     Int
  title       String
  description String
  status      TaskStatus @default(PENDING)
  order       Int

  portfolioProject PortfolioProject?

  @@map("roadmap_tasks")
}

// ---------------------------------------------------------------------------
// Side-income catalog (admin-curated) & generated matches
// ---------------------------------------------------------------------------

model SideOpportunity {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  tools                 String[] @default([])
  learningNotes         String
  starterProject        String
  portfolioRequirements String[] @default([])
  clientApproachTips    String[] @default([])

  remoteSuitable    Boolean @default(true)
  freelanceSuitable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills  SideOpportunitySkill[]
  matches SideIncomeMatch[]
  careers CareerSideOpportunity[]

  @@map("side_opportunities")
}

model SideOpportunitySkill {
  id                String          @id @default(cuid())
  sideOpportunityId String
  sideOpportunity   SideOpportunity @relation(fields: [sideOpportunityId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill           @relation(fields: [skillId], references: [id])
  level             SkillLevel

  @@unique([sideOpportunityId, skillId])
  @@map("side_opportunity_skills")
}

model SideIncomeMatch {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sideOpportunityId String
  sideOpportunity   SideOpportunity @relation(fields: [sideOpportunityId], references: [id])

  fitScore          Int
  breakdown         Json
  reasons           String[]
  missingSkillNames String[]
  rank              Int
  engineVersion     String   @default("1.0.0")

  generatedAt DateTime @default(now())

  @@unique([userId, sideOpportunityId])
  @@index([userId])
  @@map("side_income_matches")
}

// ---------------------------------------------------------------------------
// Portfolio tracker
// ---------------------------------------------------------------------------

enum PortfolioStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model PortfolioProject {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  link        String?

  careerId String?
  career   CareerProfile? @relation(fields: [careerId], references: [id])

  roadmapTaskId String?      @unique
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id])

  status    PortfolioStatus @default(PLANNED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@map("portfolio_projects")
}

// ---------------------------------------------------------------------------
// AI career assistant
// ---------------------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@map("ai_messages")
}

// =============================================================================
// PHASE 4 — Verified Opportunity Engine
//
// Trust model, in one sentence: an Opportunity only ever reaches an
// ordinary user if a human admin entered it, attached a real Source, and
// separately, explicitly marked it VERIFIED — and it stops reaching users
// the moment its deadline passes, checked at read time, not by a job that
// could be stale. Nothing here is scraped or AI-generated.
// =============================================================================

enum SourceType {
  OFFICIAL_ORGANIZATION
  GOVERNMENT
  UNIVERSITY
  INTERNATIONAL_ORGANIZATION
  PARTNER_ORGANIZATION
  APPROVED_PLATFORM
  OTHER
}

enum TrustLevel {
  HIGH
  MEDIUM
  LOW
  UNRATED
}

// Every Opportunity must reference one of these — "preserve original
// source" (Module 3/15) enforced structurally, not by convention. A
// source existing here is not itself a trust claim; TrustLevel is an
// admin's ongoing judgment, re-examined at lastCheckedAt.
model Source {
  id            String     @id @default(cuid())
  name          String
  type          SourceType
  url           String
  trustLevel    TrustLevel @default(UNRATED)
  lastCheckedAt DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  opportunities Opportunity[]

  @@map("opportunity_sources")
}

enum OpportunityCategory {
  JOB
  INTERNSHIP
  SCHOLARSHIP
  FELLOWSHIP
  GRANT
  COMPETITION
  VOLUNTEER
  REMOTE_WORK
  FREELANCE
  TRAINING_PROGRAM
  MENTORSHIP
}

enum RemoteStatus {
  REMOTE
  ON_SITE
  HYBRID
  UNSPECIFIED
}

enum ExperienceRequirement {
  NONE
  ENTRY_LEVEL
  SOME_EXPERIENCE
  EXPERIENCED
  UNSPECIFIED
}

// Trustworthiness of the content. Orthogonal to OpportunityStatus below —
// a VERIFIED opportunity can still lapse to EXPIRED without that ever
// reopening the question of whether it was trustworthy content.
enum VerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REPORTED
}

// Lifecycle: is this currently a live, displayable opportunity.
enum OpportunityStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

model Opportunity {
  id           String              @id @default(cuid())
  title        String
  organization String
  category     OpportunityCategory
  description  String

  location          String?
  country           String?
  remoteStatus      RemoteStatus @default(UNSPECIFIED)
  // Empty = no country restriction. Non-empty = the user's Profile.country
  // must appear here for the hard eligibility check (Module 5).
  eligibleCountries String[]     @default([])

  eligibilityText       String?
  minEducationLevel     EducationLevel?
  experienceRequirement ExperienceRequirement @default(UNSPECIFIED)

  // Null deadline is a real, honest state — "deadline not specified,"
  // never inferred (Module 13). Never defaulted to a fabricated date.
  applicationDeadline DateTime?
  applicationUrl      String
  datePublished       DateTime?

  sourceId  String
  source    Source @relation(fields: [sourceId], references: [id])
  // The specific page this record's facts were taken from — may be a
  // deeper URL than Source.url (e.g. the exact program page, not the
  // organization's homepage).
  sourceUrl String

  verificationStatus VerificationStatus @default(UNVERIFIED)
  opportunityStatus  OpportunityStatus  @default(DRAFT)
  lastVerifiedAt     DateTime?
  // Admin's own note on why it's in its current verification state —
  // shown only in the admin dashboard, never to end users.
  verificationNote   String?

  createdById String
  createdBy   User    @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       OpportunitySkill[]
  careers      OpportunityCareer[]
  matches      OpportunityMatch[]
  applications OpportunityApplication[]
  reports      OpportunityReport[]

  @@index([category])
  @@index([verificationStatus, opportunityStatus])
  @@map("opportunities")
}

model OpportunitySkill {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id])
  required      Boolean     @default(true)

  @@unique([opportunityId, skillId])
  @@map("opportunity_skills")
}

// Curated link to the career(s) this opportunity is relevant to — same
// editorial pattern as CareerSideOpportunity, and what the "Career
// Alignment" match factor (Module 6) reads.
model OpportunityCareer {
  id            String        @id @default(cuid())
  opportunityId String
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  careerId      String
  career        CareerProfile @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, careerId])
  @@map("opportunity_careers")
}

model OpportunityMatch {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  matchScore       Int
  // Decomposed sub-scores + categorical labels (Module 6) — same
  // transparency pattern as CareerMatch.breakdown.
  breakdown        Json
  reasons          String[]
  // Hard-requirement flags the user does not currently meet (e.g. "Requires
  // a Bachelor's degree") — always shown, never used to silently hide the
  // opportunity (Module 5: "flag appropriately").
  eligibilityFlags String[]
  engineVersion    String   @default("1.0.0")
  rank             Int
  generatedAt      DateTime @default(now())

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("opportunity_matches")
}

enum ApplicationStatus {
  SAVED
  PLANNING_TO_APPLY
  APPLIED
  INTERVIEW_SELECTION
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// "Save" (Module 8) is just creating one of these with status=SAVED.
// appliedAt is only ever set by the user's own action — 3Doors never
// claims an application happened (Module 9, Module 14).
model OpportunityApplication {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  status    ApplicationStatus @default(SAVED)
  notes     String?
  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("opportunity_applications")
}

enum ReportReason {
  SUSPICIOUS_OPPORTUNITY
  BROKEN_LINK
  INCORRECT_INFORMATION
  EXPIRED
  MISLEADING_REQUIREMENTS
  SUSPICIOUS_ORGANIZATION
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model OpportunityReport {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  reason ReportReason
  note   String?
  status ReportStatus @default(OPEN)

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@map("opportunity_reports")
}

// =============================================================================
// PHASE 2, MODULE 10 — Feedback mechanisms
//
// One generic, polymorphic table rather than a separate one per feature —
// "was this useful" is the same shape everywhere it's asked. subjectId
// points at whatever row subjectType names (an AiMessage, a CareerMatch,
// ...); there's no DB-level foreign key across that boundary, so every
// write path is responsible for checking the subject actually belongs to
// the submitting user before accepting it (see the API route).
// =============================================================================

enum FeedbackSubjectType {
  AI_MESSAGE
  CAREER_MATCH
}

// Phase 5, Module 4 — structured reasons for career-match feedback, so
// "not helpful" is actionable rather than just a downvote count. Nullable
// and CAREER_MATCH-specific in practice: an AI chat reply doesn't have a
// "doesn't match my subjects" reason, so the UI never shows this picker
// for AI_MESSAGE feedback, but the field stays generic on the shared
// polymorphic table rather than forking a second Feedback-like model.
enum FeedbackReason {
  NOT_RELEVANT
  ALREADY_KNEW
  DOESNT_MATCH_INTERESTS
  DOESNT_MATCH_SUBJECTS
  NOT_ACCESSIBLE
  WANT_MORE_INFO
  OTHER
}

model Feedback {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectType FeedbackSubjectType
  subjectId   String
  helpful     Boolean
  reason      FeedbackReason?
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One vote per user per thing — resubmitting updates it rather than
  // piling up duplicates.
  @@unique([userId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("feedback")
}
